# Dexcom API Credentials
# Get these from https://developer.dexcom.com/
DEXCOM_CLIENT_ID=your_client_id_here
DEXCOM_CLIENT_SECRET=your_client_secret_here
DEXCOM_REDIRECT_URI=http://localhost:8080/callback

# API Environment (sandbox or production)
# Use 'sandbox' for testing, 'production' for real data
DEXCOM_ENVIRONMENT=sandbox

# Database Configuration
DUCKDB_PATH=dexcom_data.db
